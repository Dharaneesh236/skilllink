# SkillLink Environment Variables (.env.example)

# Backend Configuration
JWT_SECRET=supersecretkey_change_in_production_min32chars
DATABASE_URL=sqlite:///./skilllink.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
NOMINATIM_USER_AGENT=SkillLinkMicroEmployment/1.0 (contact@skilllink.local)

# Optional Free-Tier AI (Groq) - Core platform works 100% without this!
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Frontend Configuration
VITE_API_URL=http://localhost:8000
